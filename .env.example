# Neon Postgres (Vercel Marketplace or Neon console)
DATABASE_URL=

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=
# Canonical app URL (production)
AUTH_URL=https://cohort-comms-phi.vercel.app
AUTH_TRUST_HOST=true

# GitHub OAuth app (https://github.com/settings/developers)
#   Homepage URL:              https://cohort-comms-phi.vercel.app
#   Authorization callback URL: https://cohort-comms-phi.vercel.app/api/auth/callback/github
# For local development, create a second OAuth app pointing at
# http://localhost:3000 with callback http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
#   Authorized redirect URI:
#   https://cohort-comms-phi.vercel.app/api/auth/callback/google
#   (and http://localhost:3000/api/auth/callback/google for local)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Forth inbound webhook — required for POST /api/webhooks/forth
# Without this, the webhook returns 503. Forth does not send outbound
# events today; use curl or a relay to deliver payloads.
FORTH_WEBHOOK_SECRET=

# Optional: Vercel Blob for image uploads. If unset, uploads store as data URLs.
# BLOB_READ_WRITE_TOKEN=

# Comma-separated GitHub handles who can post in #announcements and open
# /admin to manage the cohort roster.
ADMIN_HANDLES=rogerSuperBuilderAlpha,priyanshshahh

# Admins by email as well as handle. Required for an admin who signs in with
# Google, since a Google account carries no GitHub login.
ADMIN_EMAILS=
